<Window x:Class="CS90.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CS90.Controls"
        Title="CS-90 Capture Recorder"
        Width="720" Height="600" MinWidth="480" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#141414" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Tech">Consolas</FontFamily>
        <FontFamily x:Key="Logo">Bahnschrift, Segoe UI</FontFamily>

        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Shadow" Margin="0,4,0,-4" Fill="#000000" Opacity="0.6"/>
                            <Ellipse x:Name="Face" StrokeThickness="2" Stroke="#3C3C3C">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.25" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#303030" Offset="0"/>
                                        <GradientStop Color="#181818" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Margin="8" Stroke="#242424" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Stroke" Value="#5E5E5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Stroke" Value="#6A6A6A"/>
                                <Setter TargetName="Shadow" Property="Margin" Value="0,1,0,-1"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Tech}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="600" Height="500" Background="#1A1A1A">
            <Border BorderBrush="#3A3A3A" BorderThickness="1.5" CornerRadius="2"/>

            <!-- HEADER -->
            <Grid x:Name="Header" Height="86" VerticalAlignment="Top" Background="#00000000"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="CS-90" Foreground="#E8321F" FontFamily="{StaticResource Logo}"
                           FontWeight="Black" FontSize="52" Margin="28,6,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Text="C A P T U R E   R E C O R D E R" Foreground="#8A8A8A"
                           FontFamily="{StaticResource Tech}" FontSize="12" Margin="30,66,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0">
                    <Button x:Name="MinBtn" Style="{StaticResource ChromeBtn}" Click="Min_Click">
                        <Path Data="M0,0 H14" Stroke="#CFCFCF" StrokeThickness="1.6" Margin="0,8,0,0"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource ChromeBtn}" Click="Max_Click">
                        <Rectangle Width="14" Height="14" Stroke="#CFCFCF" StrokeThickness="1.6"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource ChromeBtn}" Click="Close_Click">
                        <Path Data="M0,0 L14,14 M14,0 L0,14" Stroke="#CFCFCF" StrokeThickness="1.6"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CASSETTE -->
            <c:CassetteAnimation x:Name="Cassette" Margin="28,97,0,0" Width="417" Height="160"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- TIMER + REC INDICATOR -->
            <Ellipse x:Name="RecLed" Width="10" Height="10" Fill="#4A1410" Margin="464,150,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Rectangle Height="1" Width="118" Fill="#3A3A3A" Margin="462,184,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock x:Name="TimerText" Text="00:00:00" Foreground="#E6E6E6"
                       FontFamily="{StaticResource Tech}" FontSize="27" Margin="460,206,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- TRANSPORT -->
            <Button x:Name="RecBtn" Style="{StaticResource RoundBtn}" Margin="50,291,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="Rec_Click">
                <Ellipse x:Name="RecDot" Width="26" Height="26" Fill="#E8321F"/>
            </Button>
            <Button x:Name="StopBtn" Style="{StaticResource RoundBtn}" Margin="175,291,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="Stop_Click">
                <Rectangle Width="22" Height="22" RadiusX="2" RadiusY="2" Fill="#CFCFCF"/>
            </Button>
            <Button x:Name="PlayBtn" Style="{StaticResource RoundBtn}" Margin="300,291,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="Play_Click">
                <Path Data="M0,0 L24,14 L0,28 Z" Fill="#CFCFCF" Margin="5,0,0,0"/>
            </Button>
            <Rectangle Width="1" Height="86" Fill="#3A3A3A" Margin="470,288,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button x:Name="ClearBtn" Style="{StaticResource RoundBtn}" Margin="493,291,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="Clear_Click">
                <Path Data="M2,6 H22 M9,6 V2 H15 V6 M4,6 L5.5,23 H18.5 L20,6 M10,10 V19 M14,10 V19"
                      Stroke="#CFCFCF" StrokeThickness="1.8" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="26"/>
            </Button>

            <TextBlock Text="REC" Style="{StaticResource TransportLabel}" Foreground="#E8321F"
                       Margin="50,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock Text="STOP" Style="{StaticResource TransportLabel}"
                       Margin="175,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock Text="PLAY" Style="{StaticResource TransportLabel}"
                       Margin="300,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock x:Name="ClearLabel" Text="CLEAR" Style="{StaticResource TransportLabel}"
                       Margin="493,380,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- WAVEFORM + DRAG TO DAW -->
            <Rectangle Height="1" Width="544" Fill="#3A3A3A" Margin="28,415,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <c:WaveformControl x:Name="Wave" Margin="28,424,0,0" Width="350" Height="62"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <Border x:Name="DragZone" Margin="396,432,0,0" Width="176" Height="48"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#6A6A6A" BorderThickness="1.2" CornerRadius="4" Background="#00000000"
                    Cursor="Hand" ToolTip="Drag into your DAW"
                    PreviewMouseLeftButtonDown="Drag_MouseDown"
                    PreviewMouseMove="Drag_MouseMove"
                    PreviewMouseLeftButtonUp="Drag_MouseUp">
                <Grid>
                    <TextBlock x:Name="DragText" Text="DRAG TO DAW" Foreground="#B5B5B5"
                               FontFamily="{StaticResource Tech}" FontSize="13"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Path Data="M7,12 V2 M3,6 L7,2 L11,6 M1,10 V17 H13 V10" Stroke="#B5B5B5" StrokeThickness="1.5"
                          StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,14,0" Width="14" Height="18"/>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
